BOT_TOKEN=123456:ABC...
GEMINI_API_KEY=...
# Neon / Render Postgres: postgresql://user:pass@host/db
DATABASE_URL=postgresql://user:pass@host/db
# Публичный URL сервиса Render (без слэша в конце), например https://mybot.onrender.com
BASE_URL=
# Секретная часть пути вебхука (любая случайная строка)
WEBHOOK_SECRET=change-me-random-string
# Таймзона по умолчанию
DEFAULT_TZ=Europe/Moscow
# Локальная разработка без вебхука: 1 = long polling
POLLING=0
